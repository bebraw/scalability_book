{
  "domain": "scalableweb.dev",
  "title": "Elements of Scalable Web Applications",
  "description": "Course book for Designing and Building Scalable Web Applications at Aalto University.",
  "course": "Designing and Building Scalable Web Applications",
  "audience": "MSc-level students",
  "author": {
    "name": "Juho Vepsäläinen",
    "url": "https://survivejs.com/",
  },

  // Only chapters listed here are published. Leave work-in-progress chapters out
  // until they are ready for the public site.
  "chapters": [
    "book/00_introduction.md",
    "book/01_construct/01_scalable_development.md",
    /*"book/01_construct/02_what_is_scalability.md",
    "book/01_construct/03_architecture.md",
    "book/02_reconstruct/04_friction.md",
    "book/02_reconstruct/05_benchmarking.md",
    "book/02_reconstruct/06_reality.md",
    "book/03_deconstruct/07_agent_fleets.md",
    "book/03_deconstruct/08_scaling.md",
    "book/03_deconstruct/09_recap.md"*/
  ],

  // The course runs in three three-week parts. Each part maps to three book
  // chapters and constrains the AI assistance mode allowed during that phase.
  "parts": [
    {
      "number": "I",
      "title": "Construct",
      "description": "Only copilot-based assistance is allowed.",
      "file": "book/01_construct/00_construct.md",
      "chapters": [
        "book/01_construct/01_scalable_development.md",
        "book/01_construct/02_what_is_scalability.md",
        "book/01_construct/03_architecture.md",
      ],
    },
    {
      "number": "II",
      "title": "Reconstruct",
      "description": "Only a single agent is allowed.",
      "file": "book/02_reconstruct/00_reconstruct.md",
      "chapters": [
        "book/02_reconstruct/04_friction.md",
        "book/02_reconstruct/05_benchmarking.md",
        "book/02_reconstruct/06_reality.md",
      ],
    },
    {
      "number": "III",
      "title": "Deconstruct",
      "description": "Agent orchestration is allowed.",
      "file": "book/03_deconstruct/00_deconstruct.md",
      "chapters": [
        "book/03_deconstruct/07_agent_fleets.md",
        "book/03_deconstruct/08_scaling.md",
        "book/03_deconstruct/09_recap.md",
      ],
    },
  ],

  // Theme choices shown in the site header.
  "themes": [
    {
      "id": "light",
      "label": "Light",
    },
    {
      "id": "dark",
      "label": "Dark",
    },
    {
      "id": "sepia",
      "label": "Sepia",
    },
    {
      "id": "contrast",
      "label": "High contrast",
    },
    {
      "id": "calm",
      "label": "Calm",
    },
  ],
}
