{
  "domain": "scalableweb.dev",
  "title": "Elements of Scalable Web Applications",
  "description": "Course book for Designing and Building Scalable Web Applications at Aalto University.",
  "course": "Designing and Building Scalable Web Applications",
  "audience": "MSc-level students",
  "author": {
    "name": "Juho Vepsäläinen",
    "url": "https://survivejs.com/",
  },

  // Only chapters listed here are published. Leave work-in-progress chapters out
  // until they are ready for the public site.
  "chapters": [
    "book/00_introduction.md",
    "book/01_establish/01_what_is_scalability.md",
    "book/01_establish/02_scalable_development.md",
    /*"book/01_establish/03_benchmarking.md",
    "book/02_challenge/04_architecture.md",
    "book/02_challenge/05_friction.md",
    "book/02_challenge/06_reality.md",
    "book/03_compare/07_agent_fleets.md",
    "book/03_compare/08_scaling.md",
    "book/03_compare/09_recap.md"*/
  ],

  // Case studies support the chapters without interrupting their main argument.
  // Each source is published below /case-studies/{slug}/.
  "caseStudies": [
    {
      "file": "case-studies/kirjolab.md",
      "slug": "kirjolab",
      "repositoryUrl": "https://github.com/bebraw/kirjolab",
      "summary": "How a strong development harness enabled exceptional delivery speed while architectural understanding struggled to keep up.",
    },
  ],

  // The course runs in three three-week parts. Each part maps to three book
  // chapters and constrains the AI assistance mode allowed during that phase.
  "parts": [
    {
      "number": "I",
      "title": "Establish",
      "description": "Define scalability, build implementation A, and establish a shared evidence baseline.",
      "file": "book/01_establish/00_establish.md",
      "chapters": [
        "book/01_establish/01_what_is_scalability.md",
        "book/01_establish/02_scalable_development.md",
        "book/01_establish/03_benchmarking.md",
      ],
    },
    {
      "number": "II",
      "title": "Challenge",
      "description": "Challenge the baseline through architecture, friction, production pressure, and implementation B.",
      "file": "book/02_challenge/00_challenge.md",
      "chapters": [
        "book/02_challenge/04_architecture.md",
        "book/02_challenge/05_friction.md",
        "book/02_challenge/06_reality.md",
      ],
    },
    {
      "number": "III",
      "title": "Compare",
      "description": "Build implementation C through a declared agent fleet, compare all three systems, and form an engineering judgment.",
      "file": "book/03_compare/00_compare.md",
      "chapters": [
        "book/03_compare/07_agent_fleets.md",
        "book/03_compare/08_scaling.md",
        "book/03_compare/09_recap.md",
      ],
    },
  ],

  // Theme choices shown in the site header.
  "themes": [
    {
      "id": "light",
      "label": "Light",
    },
    {
      "id": "dark",
      "label": "Dark",
    },
    {
      "id": "sepia",
      "label": "Sepia",
    },
    {
      "id": "contrast",
      "label": "High contrast",
    },
    {
      "id": "calm",
      "label": "Calm",
    },
  ],
}
