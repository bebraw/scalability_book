{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "scalability-book-course-local",
  "main": "worker/index.ts",
  // Match the book Worker and the pinned local runtime; upgrade both together.
  "compatibility_date": "2026-05-02",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./build",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "COURSE_DB",
      "database_name": "scalability-book-course",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "course-migrations",
    },
    {
      "binding": "COURSE_SIMULATION_DB",
      "database_name": "scalability-book-course-simulation",
      "database_id": "00000000-0000-0000-0000-000000000007",
      "migrations_dir": "course-migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "COURSE_FILES",
      "bucket_name": "scalability-book-course-files",
    },
    {
      "binding": "COURSE_SIMULATION_FILES",
      "bucket_name": "scalability-book-course-simulation-files",
    },
  ],
  // Native binding shape is checked here, but local login uses the app's mock
  // inbox. Do not enable remote mail in development or teacher simulations.
  "send_email": [
    {
      "name": "COURSE_MAIL",
      "allowed_sender_addresses": ["info@scalableweb.dev"],
    },
  ],
  "vars": {
    "COURSE_EMAIL_ENABLED": "false",
    "COURSE_SIMULATION_ID": "course-simulation-local-v1",
  },
  "observability": { "enabled": true },
}
