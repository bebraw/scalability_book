{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "scalability-book",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-02",
  "compatibility_flags": ["nodejs_compat"],
  // Course portal bindings are separate from private chapter exercises.
  // Provision COURSE_DB and COURSE_FILES using docs/course-system.md before enabling.
  // "d1_databases": [{ "binding": "COURSE_DB", "database_name": "scalability-book-course",
  //   "database_id": "<created-database-id>", "migrations_dir": "course-migrations" }],
  // "r2_buckets": [{ "binding": "COURSE_FILES", "bucket_name": "scalability-book-course-files" }],
  // COURSE_ADMIN_GITHUB_LOGINS grants course administration separately from book moderation.
  // Course sender and incoming forwarding destination stay in Worker secrets:
  // COURSE_EMAIL_FROM and COURSE_EMAIL_FORWARD_TO. The Email Routing rule
  // matches the configured course inbox and sends to this Worker.
  // Email Sending is onboarded; requests cannot override the secret sender.
  // Merge COURSE_EMAIL_ENABLED: "true" into vars only after the mail setup in
  // docs/course-system.md. A binding alone does not enable login delivery.
  // Teacher simulation requires separate COURSE_SIMULATION_DB and
  // COURSE_SIMULATION_FILES resources and COURSE_SIMULATION_ID. Initialize
  // their matching markers with docs/course-system.md; never alias live bindings.
  // Simulation always uses mock mail, regardless of COURSE_EMAIL_ENABLED.
  "send_email": [{ "name": "COURSE_MAIL" }],
  "vars": { "COURSE_EMAIL_ENABLED": "false" },
  // Private exercise answers use a separate D1 database. Provision and migrate
  // it before enabling production saves; see docs/chapter-exercises.md.
  // "d1_databases": [{
  //   "binding": "LEARNING_DB",
  //   "database_name": "scalability-book-learning",
  //   "database_id": "<created-database-id>",
  //   "migrations_dir": "migrations"
  // }],
  "build": {
    "command": "npm run worker:build",
  },
  "assets": {
    "directory": "./build",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  // To enable public feedback, create a namespace with:
  //   wrangler kv namespace create COMMENTS_KV
  // Then add the binding:
  // "kv_namespaces": [
  //   {
  //     "binding": "COMMENTS_KV",
  //     "id": "replace-with-comments-kv-namespace-id",
  //   },
  // ],
  // Also configure these as Worker secrets/vars:
  //   GITHUB_CLIENT_ID
  //   GITHUB_CLIENT_SECRET
  //   SESSION_SECRET
  //   ADMIN_GITHUB_LOGINS (comma-separated GitHub usernames)
  "routes": [
    {
      "pattern": "scalableweb.dev",
      "custom_domain": true,
    },
  ],
  "kv_namespaces": [
    {
      "binding": "COMMENTS_KV",
      "id": "c94bf94ed45f4e949bd494c6d47f8350",
      "remote": true,
    },
  ],
}
