{
  "name": "elements-of-scalable-web-applications",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-site.mjs",
    "comments:pull": "node scripts/sync-comments.mjs pull",
    "comments:push": "node scripts/sync-comments.mjs push",
    "comments:sync": "node scripts/sync-comments.mjs sync",
    "dev": "node scripts/dev-site.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "node scripts/dev-site.mjs",
    "serve": "gustwind --serve --input ./build --port 3000",
    "worker:prepare": "node scripts/generate-worker-manifest.mjs",
    "worker:build": "npm run build && npm run worker:prepare",
    "worker:dev": "npm run worker:build && wrangler dev",
    "deploy": "npm run worker:build && wrangler deploy",
    "validate": "node --check scripts/build-site.mjs && node --check scripts/dev-site.mjs && node --check scripts/generate-worker-manifest.mjs && gustwind --validate --input ./build"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@tailwindcss/typography": "0.5.19",
    "easymde": "2.20.0",
    "gustwind": "0.109.0",
    "highlight.js": "11.11.1",
    "marked": "18.0.2",
    "vite": "8.0.10"
  },
  "devDependencies": {
    "prettier": "3.8.3",
    "wrangler": "4.86.0"
  }
}
