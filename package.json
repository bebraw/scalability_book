{
  "name": "elements-of-scalable-web-development",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-site.ts",
    "study:export": "node scripts/export-study.ts",
    "comments:pull": "node scripts/sync-comments.ts pull",
    "comments:push": "node scripts/sync-comments.ts push",
    "comments:sync": "node scripts/sync-comments.ts sync",
    "dev": "node scripts/dev-site.ts",
    "e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lab:mutation": "node labs/concern-directed-mutation/run.ts",
    "pdf": "node scripts/build-pdf.ts",
    "qa:demos": "playwright test tests/e2e/*demo.spec.ts",
    "slides:pdf": "node scripts/build-lecture-pdfs.ts",
    "playwright:install": "playwright install chromium",
    "serve": "gustwind --serve --input ./build --port 3000",
    "test:unit": "node --test tests/*.test.ts",
    "worker:prepare": "node scripts/generate-worker-manifest.ts",
    "worker:build": "npm run build && npm run worker:prepare",
    "preview:worker": "npm run worker:build && wrangler dev",
    "deploy": "npm run worker:build && wrangler deploy",
    "validate": "npm run types:check && gustwind --validate --input ./build",
    "types:check": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "browserslist": [
    "defaults",
    "safari >= 13",
    "ios_saf >= 13"
  ],
  "dependencies": {
    "@citation-js/core": "0.8.2",
    "@citation-js/plugin-bibtex": "0.8.2",
    "@citation-js/plugin-csl": "0.8.2",
    "@ngrok/webernetes": "0.1.5",
    "@tailwindcss/typography": "0.5.19",
    "easymde": "2.20.0",
    "elkjs": "0.12.0",
    "gustwind": "0.109.0",
    "hast-util-from-html": "2.0.3",
    "highlight.js": "11.11.1",
    "scholarmark": "0.9.1",
    "vite": "8.0.10",
    "xstate": "5.32.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@cloudflare/workers-types": "4.20260702.1",
    "@playwright/test": "1.60.0",
    "@types/hast": "3.0.5",
    "@types/node": "25.7.0",
    "browserslist": "4.28.2",
    "prettier": "3.8.3",
    "prettier-plugin-sentences-per-line": "0.2.4",
    "sharp": "0.34.5",
    "typescript": "6.0.3",
    "wrangler": "4.86.0"
  }
}
