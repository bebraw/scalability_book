{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/course/fleet-trace.schema.json",
  "title": "Portable course fleet trace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run",
    "actors",
    "tasks",
    "events",
    "redaction"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run": {
      "$ref": "#/$defs/run"
    },
    "actors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/actor"
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "redaction": {
      "$ref": "#/$defs/redaction"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "started_at",
        "ended_at",
        "outcome",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "started_at": {
          "$ref": "#/$defs/timestamp"
        },
        "ended_at": {
          "$ref": "#/$defs/timestamp"
        },
        "outcome": {
          "enum": ["accepted", "partial", "failed", "cancelled"]
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["system", "export_revision", "exported_at"],
          "properties": {
            "system": {
              "type": "string",
              "minLength": 1
            },
            "export_revision": {
              "type": "string",
              "minLength": 1
            },
            "exported_at": {
              "$ref": "#/$defs/timestamp"
            }
          }
        }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "role"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": ["agent", "human"]
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": ["string", "null"]
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cost_usd": {
          "type": ["number", "null"],
          "minimum": 0
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "state",
        "outcome",
        "assigned_actor_id",
        "depends_on",
        "created_at"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": ["open", "in_progress", "done"]
        },
        "outcome": {
          "enum": ["pending", "accepted", "failed", "cancelled"]
        },
        "assigned_actor_id": {
          "$ref": "#/$defs/identifier"
        },
        "parent_task_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "started_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "completed_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "metrics": {
          "$ref": "#/$defs/metrics"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sequence",
        "type",
        "task_id",
        "actor_id",
        "occurred_at",
        "metadata"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "enum": [
            "task_created",
            "delegation",
            "task_started",
            "task_completed",
            "handoff",
            "failure",
            "retry",
            "validation",
            "review",
            "human_intervention"
          ]
        },
        "task_id": {
          "$ref": "#/$defs/identifier"
        },
        "actor_id": {
          "$ref": "#/$defs/identifier"
        },
        "occurred_at": {
          "$ref": "#/$defs/timestamp"
        },
        "attempt_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "removed", "reviewed_by"],
      "properties": {
        "status": {
          "enum": ["redacted", "not_required"]
        },
        "removed": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "reviewed_by": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
